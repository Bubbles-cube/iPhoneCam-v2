<Window x:Class="iPhoneCam.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="泡泡直播助手" Height="780" Width="1160" Icon="assets/icon.ico"
        WindowStyle="None" ResizeMode="CanResize" MinWidth="940" MinHeight="620"
        AllowsTransparency="True" Background="Transparent"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        FontFamily="{StaticResource BodyFont}">

    <!-- 玻璃外框（真透明視窗）：深玻璃 70%（可讀）＋ Liquid Glass 高光邊與圓角 -->
    <Border Margin="0" Background="#B312122A" CornerRadius="20"
            BorderBrush="{StaticResource NeonBorderBrush}" BorderThickness="1"
            MouseLeftButtonDown="Border_Drag">
        <DockPanel>

            <!-- ===================== 標題列 ===================== -->
            <Grid DockPanel.Dock="Top" Margin="20,14,10,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="泡泡直播助手" Foreground="{StaticResource TextBrush}"
                               FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="PC 端" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <Border Background="#1FFFFFFF" BorderBrush="{StaticResource GlassBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="10,4" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeadConn" Text="○ 未連接手機"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnMin" Content="&#xE921;" Style="{StaticResource TitleBarButton}"
                            Click="BtnMin_Click" ToolTip="最小化"/>
                    <Button x:Name="BtnClose" Content="&#xE8BB;" Style="{StaticResource TitleBarButton}"
                            Click="BtnClose_Click" ToolTip="關閉（虛擬相機下線）"/>
                </StackPanel>
            </Grid>

            <!-- ===================== 狀態列 ===================== -->
            <Grid DockPanel.Dock="Bottom" Margin="22,6,22,14">
                <TextBlock x:Name="TxtStatus" Text="就緒" Style="{StaticResource MonoText}" FontSize="11"/>
                <TextBlock x:Name="TxtVersion" Text="v2 · CAM1" Style="{StaticResource MonoText}"
                           FontSize="11" HorizontalAlignment="Right" Foreground="{StaticResource MutedDimBrush}"/>
            </Grid>

            <!-- ===================== 內文 ===================== -->
            <Grid Margin="14,4,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左導航（玻璃面板） -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,4,12,10" Padding="10">
                    <StackPanel>
                        <Button x:Name="NavHome" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Home">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="主畫面" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="設定" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavAbout" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="About">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="關於" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 主畫面：預覽 + 裝置/系統 -->
                <Grid x:Name="PageHome" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>

                    <!-- 預覽（填滿高度） -->
                    <Border Grid.Column="0" Background="#40000000" BorderBrush="{StaticResource GlassBorderBrush}"
                            BorderThickness="1" CornerRadius="20" Margin="0,4,12,10">
                        <Grid>
                            <Image x:Name="ImgPreview" Stretch="Uniform"/>
                            <!-- 待機畫面 -->
                            <Grid x:Name="StandbyPanel">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="130" Height="130" HorizontalAlignment="Center">
                                        <Ellipse x:Name="StandbyRing" Stroke="{StaticResource NeonBorderBrush}"
                                                 StrokeThickness="2" Fill="#1AFFFFFF"/>
                                        <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="52"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="等待手機連線" Foreground="{StaticResource TextBrush}" FontSize="17"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                                    <TextBlock Text="在手機端按「開始直播」" Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="StandbyRing"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0.45" To="1" Duration="0:0:1.4"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                            </Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="14,12,0,0">
                                <Border Background="{StaticResource PinkPurpleBrush}" CornerRadius="8"
                                        Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtLive" Text="● LIVE" Foreground="White" FontSize="12"
                                               FontWeight="Bold" Visibility="Collapsed"/>
                                </Border>
                                <TextBlock x:Name="TxtPreview" Text="等串流…" Foreground="{StaticResource MutedBrush}"
                                           FontSize="12" FontFamily="{StaticResource MonoFont}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 右側面板：裝置 / 系統 -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,4,0,10">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Border Background="#1FFFFFFF" BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="TabDevice" Content="裝置" Style="{StaticResource TabButton}"
                                                Click="Tab_Click" Tag="Device"/>
                                        <Button x:Name="TabSys" Content="系統" Style="{StaticResource TabButton}"
                                                Click="Tab_Click" Tag="Sys"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 裝置管理 -->
                            <StackPanel x:Name="PanelDevice">
                                <TextBlock Text="可連線手機（手機開 App 按開始廣播後出現）" Style="{StaticResource MutedText}"/>
                                <ListBox x:Name="LstPhones" Style="{StaticResource NeonList}" Height="180" Margin="0,10,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="BtnConnect" Content="連線" Style="{StaticResource PrimaryButton}"
                                            Click="BtnConnect_Click"/>
                                    <Button x:Name="BtnDisconnect" Content="中斷" Style="{StaticResource GhostButton}"
                                            Click="BtnDisconnect_Click" IsEnabled="False" Margin="10,0,0,0"/>
                                </StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button x:Name="BtnManual" Content="連 IP" Style="{StaticResource GhostButton}"
                                            Click="BtnManual_Click" DockPanel.Dock="Right" Margin="10,0,0,0"/>
                                    <TextBox x:Name="TxtIp" Style="{StaticResource NeonInput}"
                                             VerticalContentAlignment="Center"/>
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,12"/>
                                <TextBlock x:Name="TxtPhone" Text="未連線" Style="{StaticResource MonoText}"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock x:Name="TxtNet" Text="接收：未連線" Style="{StaticResource MonoText}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- 系統 -->
                            <StackPanel x:Name="PanelSys" Visibility="Collapsed">
                                <Button x:Name="BtnSave" Style="{StaticResource GhostButton}" Click="BtnSave_Click"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtSave" Text="存檔：關"/>
                                    </StackPanel>
                                </Button>
                                <CheckBox x:Name="ChkSoftDec" Content="強制軟解（重連生效）" Style="{StaticResource NeonCheck}"
                                          Margin="2,8,0,0" Checked="ChkSoftDec_Changed" Unchecked="ChkSoftDec_Changed"/>
                                <TextBlock x:Name="TxtDecMode" Text="解碼：－" Foreground="{StaticResource PrimaryBrush}"
                                           FontSize="12" FontFamily="{StaticResource MonoFont}" Margin="2,10,0,0"/>
                                <TextBlock x:Name="TxtStats" Text="幀：－" Style="{StaticResource MonoText}"
                                           Margin="2,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- 子頁（設定／關於） -->
                <Grid x:Name="PageSub" Grid.Column="1" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,4,0,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="TxtPageTitle" Text="設定" Foreground="{StaticResource TextBrush}"
                                           FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                                           Margin="2,0,0,10"/>
                                <StackPanel x:Name="PageSettings" Visibility="Collapsed">
                                    <TextBlock Text="解碼器由系統自動選擇（D3D11VA 硬解優先，失敗自動退軟解）。"
                                               Style="{StaticResource MutedText}" Margin="0,4,0,8"/>
                                    <TextBlock Text="解析度／FPS／鏡頭在手機端調整即可，PC 不重複顯示。"
                                               Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                                    <TextBlock Text="錄影存到 _captures／recv-*.h264；截圖存到 _captures／snap-*.png。"
                                               Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                                    <TextBlock Text="關閉本程式＝虛擬相機下線。" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                                    <TextBlock Text="泡泡直播助手 PC 端 v2（玻璃擬態重製）" Foreground="{StaticResource TextBrush}"
                                               FontSize="13" Margin="0,4,0,8"/>
                                    <TextBlock Text="手機鏡頭 → Wi-Fi → PC 虛擬攝像頭 → OBS／Discord。影像走 UDP（CUM1）抗無線抖動，控制走 CAM1。"
                                               Style="{StaticResource MutedText}"/>
                                    <Button x:Name="BtnDiag" Content="複製診斷" Style="{StaticResource GhostButton}"
                                            Click="BtnDiag_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
